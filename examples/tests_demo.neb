// Test framework demo — run with: nebula test tests_demo.neb

fn fib(n) {
    if n <= 1 { rt n }
    mt a = 0; mt b = 1
    fo _ in 2..=n { lt t = b; b = a + b; a = t }
    b
}

fn qsort(a) {
    if a.ln() <= 1 { rt a }
    lt p = a[0]
    lt r = a.skip(1)
    qsort(r.fl(|x| x <= p)) + [p] + qsort(r.fl(|x| x > p))
}

#[test]
fn test_fib_base_cases() {
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
}

#[test]
fn test_fib_values() {
    assert_eq(fib(10), 55)
    assert_eq(fib(20), 6765)
}

#[test]
fn test_sort_empty() {
    assert_eq(qsort([]), [])
}

#[test]
fn test_sort_already_sorted() {
    assert_eq(qsort([1, 2, 3]), [1, 2, 3])
}

#[test]
fn test_sort_reverse() {
    assert_eq(qsort([5, 4, 3, 2, 1]), [1, 2, 3, 4, 5])
}

#[test]
fn test_sort_duplicates() {
    assert_eq(qsort([3, 1, 4, 1, 5]), [1, 1, 3, 4, 5])
}

#[test]
fn test_list_methods() {
    assert_eq([1, 2, 3].sum(), 6)
    assert_eq([3, 1, 2].srt(), [1, 2, 3])
    assert_eq([1, 2, 2, 3].unq(), [1, 2, 3])
    assert_eq([1, 2, 3].rv(), [3, 2, 1])
}

#[test]
fn test_string_methods() {
    assert_eq("hello".to_upper(), "HELLO")
    assert_eq("  hi  ".trim(), "hi")
    assert_eq("abc".rev(), "cba")
    assert_eq("a,b,c".split(",").ln(), 3)
}
