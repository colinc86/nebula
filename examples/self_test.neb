// Self-test: Nebula testing itself — validates core features from within

#[test]
fn test_arithmetic() {
    assert_eq(2 + 3, 5)
    assert_eq(10 - 4, 6)
    assert_eq(3 * 7, 21)
    assert_eq(15 / 4, 3)
    assert_eq(17 % 5, 2)
    assert_eq(2 ** 10, 1024)
    assert_eq(10.5 % 3.0, 1.5)
}

#[test]
fn test_comparison() {
    assert(3.14 > 3)
    assert(5.0 >= 5)
    assert('a' < 'z')
    assert(nil == nil)
    assert(1 != 2)
}

#[test]
fn test_short_circuit() {
    // and should not evaluate right side if left is false
    assert_eq(ff and (1/0 > 0), ff)
    // or should not evaluate right side if left is true
    assert(tt or (1/0 > 0))
}

#[test]
fn test_strings() {
    assert_eq("hello".to_upper(), "HELLO")
    assert_eq("  hi  ".trim(), "hi")
    assert_eq("abc".rev(), "cba")
    assert_eq("abc".ln(), 3)
    assert_eq("hello".index_of("llo"), 2)
    assert_eq("hello".substring(1, 4), "ell")
    assert_contains("hello world", "world")
}

#[test]
fn test_lists() {
    assert_eq([1, 2, 3].ln(), 3)
    assert_eq([1, 2, 3].sum(), 6)
    assert_eq([3, 1, 2].srt(), [1, 2, 3])
    assert_eq([1, 2, 2, 3].unq(), [1, 2, 3])
    assert_eq([1, 2, 3].rv(), [3, 2, 1])
    assert_eq([1, 2, 3].first(), 1)
    assert_eq([1, 2, 3].last(), 3)
    assert_eq([1, 2, 3].take(2), [1, 2])
    assert_eq([1, 2, 3].skip(1), [2, 3])
    assert_eq([1, 2, 3, 4].cnt(|x| x > 2), 2)
    assert_eq([1, 2, 3].reduce(|a, b| a + b), 6)
    assert_contains([1, 2, 3], 2)
}

#[test]
fn test_list_equality() {
    assert([1, 2, 3] == [1, 2, 3])
    assert([1, 2] != [1, 3])
    assert([] == [])
    assert([[1], [2]] == [[1], [2]])
}

#[test]
fn test_maps() {
    lt m = {"a": 1, "b": 2}
    assert_eq(m.ln(), 2)
    assert_eq(m.keys().srt(), ["a", "b"])
    assert_eq(m.get("a"), 1)
    assert_eq(m.get("z", 99), 99)
    assert(m.ck("a"))
    assert(not m.ck("z"))
}

#[test]
fn test_slicing() {
    assert_eq([10, 20, 30, 40, 50][1..3], [20, 30])
    assert_eq([10, 20, 30, 40, 50][1..=3], [20, 30, 40])
    assert_eq([10, 20, 30][-1], 30)
    assert_eq("hello"[1..4], "ell")
}

#[test]
fn test_destructuring() {
    lt (a, b) = (10, 20)
    assert_eq(a + b, 30)
    lt (x, y, z) = [1, 2, 3]
    assert_eq(x + y + z, 6)
}

#[test]
fn test_closures() {
    fn make_adder(n) = |x| x + n
    lt add5 = make_adder(5)
    assert_eq(add5(10), 15)
    assert_eq(add5(0), 5)
}

#[test]
fn test_first_class_fn() {
    fn double(x) = x * 2
    assert_eq([1, 2, 3].mp(double), [2, 4, 6])
}

#[test]
fn test_match() {
    fn classify(n) = mc n {
        0 => "zero"
        1..=9 => "small"
        _ if n > 100 => "huge"
        _ => "other"
    }
    assert_eq(classify(0), "zero")
    assert_eq(classify(5), "small")
    assert_eq(classify(200), "huge")
    assert_eq(classify(50), "other")
}

#[test]
fn test_try_catch() {
    lt result = try { 1 / 0 } ch e { e }
    assert_contains(result, "Division by zero")
    lt ok = try { 42 } ch _ { -1 }
    assert_eq(ok, 42)
}

#[test]
fn test_map_iteration() {
    mt keys = []
    fo k, _ in {"a": 1, "b": 2} {
        keys = keys.psh(k)
    }
    assert_eq(keys.srt(), ["a", "b"])
}

#[test]
fn test_nil_coalesce() {
    assert_eq(nil ?? 42, 42)
    assert_eq(nil ?? nil ?? 99, 99)
    assert_eq(5 ?? 42, 5)
}

#[test]
fn test_type_of() {
    assert_eq(typ(42), "Int")
    assert_eq(typ(3.14), "Float")
    assert_eq(typ("hi"), "String")
    assert_eq(typ(tt), "Bool")
    assert_eq(typ([]), "List")
    assert_eq(typ({}), "Map")
    assert_eq(typ(nil), "Nil")
}

#[test]
fn test_range() {
    assert_eq(range(5), [0, 1, 2, 3, 4])
    assert_eq(range(2, 5), [2, 3, 4])
}
