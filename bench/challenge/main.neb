  mt store = NewTaskStore()
  store.Add("Design database schema", Critical)
  store.Add("Implement user auth", High)
  store.Add("Write unit tests", Medium)
  store.Add("Setup CI pipeline", Medium)
  store.Add("Create API docs", Low)
  store.Add("Performance profiling", High)
  store.Add("Security audit", Critical)
  store.Add("Refactor middleware", Medium)
  store.Add("Add logging", Low)
  store.Add("Deploy to staging", High)
  if ok {
  t.Assignee = "alice"
  t.Tags = ["backend", "database"]
  }
  if ok {
  t.Assignee = "bob"
  t.Status = InProgress
  t.Tags = ["backend", "security"]
  }
  if ok {
  mt due = time.Now().Add(-48 * time.Hour)
  t.DueDate = due
  t.Tags = ["security", "compliance"]
  }
  if ok {
  t.Subtasks = [3, 4]
  }
  store.BulkUpdateStatus([4, 9], Done)
  store.AutoAssign(["alice", "bob", "charlie"])
  prt(GenerateReport(store))
  prt("=== Ranked Tasks ===")
  fo i, t in RankTasks(store) {
  prt(" %d. [%d] %s (score: %.2f, assignee: %s)", i + 1, t.ID, t.Title, ScoreTask(t), t.Assignee)
  }
  prt("=== Fuzzy Search: 'auth' ===")
  fo _, t in FuzzySearch(store, "auth", 3) {
  prt(" [%d] %s", t.ID, t.Title)
  }
  prt("Cycle detection (task 1): %v", store.HasCycle(1))
}