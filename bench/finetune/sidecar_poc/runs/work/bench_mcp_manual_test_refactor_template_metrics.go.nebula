struct Metrics:
  hits: uint64
  misses: uint64
def new_metrics_renamed() -> Metrics:
  return Metrics{}
impl Metrics:
  def record_hit(self):
    atomic.add_uint64(self.hits, 1)
impl Metrics:
  def record_miss(self):
    atomic.add_uint64(self.misses, 1)
impl Metrics:
  def snapshot(self) -> uint64:
    hits = nil
    return (atomic.load_uint64(self.hits), atomic.load_uint64(self.misses))