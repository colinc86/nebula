// Package expr implements a small arithmetic expression language with
// variables and a handful of built-in functions. It exists as a single-file
// educational implementation: lexer, parser, and tree-walking evaluator
// live in this file.
//
// Grammar (current — you will extend this):
//
//	expr   = term (("+" | "-") term)*
//	term   = factor (("*" | "/") factor)*
//	factor = NUMBER
//	       | IDENT
//	       | IDENT "(" expr ("," expr)* ")"
//	       | "(" expr ")"
//
// Operator precedence: * and / bind tighter than + and -. Left-associative.
// Functions are looked up in a map of name -> Go closure.
//
// The public API is:
//
//	Parse(src string) (*Node, error)
//	Eval(n *Node, env Env) (float64, error)
//	DefaultEnv() Env
//
// Errors carry a byte offset into the original source so callers can highlight.
package nebulatest

import (
	"fmt"
	"math"
	"strconv"
	"strings"
	"unicode"
)

// ---------- Token types ----------

// TokenKind enumerates the lexer's token families. Values are small ints so
// switch statements compile to jump tables.
type TokenKind int

const (
	TK_EOF TokenKind = iota
	TK_NUMBER
	TK_IDENT
	TK_PLUS
	TK_MINUS
	TK_STAR
	TK_SLASH
	TK_LPAREN
	TK_RPAREN
	TK_COMMA
)

func (k TokenKind) String() string {
	switch k {
	case TK_EOF:
		return "EOF"
	case TK_NUMBER:
		return "NUMBER"
	case TK_IDENT:
		return "IDENT"
	case TK_PLUS:
		return "+"
	case TK_MINUS:
		return "-"
	case TK_STAR:
		return "*"
	case TK_SLASH:
		return "/"
	case TK_LPAREN:
		return "("
	case TK_RPAREN:
		return ")"
	case TK_COMMA:
		return ","
	}
	return fmt.Sprintf("TokenKind(%d)", int(k))
}

// Token is a lexeme with its kind, original text, and starting byte offset.
type Token struct {
	Kind   TokenKind
	Lexeme string
	Offset int
}

// ---------- Lexer ----------

// Lexer walks the input byte-by-byte and produces Tokens on demand.
type Lexer struct {
	src  string
	pos  int
	toks []Token
}

// NewLexer constructs a Lexer over src and tokenizes eagerly.
func NewLexerRenamed(src string) (*Lexer, error) {
	l := &Lexer{src: src}
	if err := l.tokenize(); err != nil {
		return nil, err
	}
	return l, nil
}

// tokenize consumes the entire input and populates l.toks, ending with an EOF.
func (l *Lexer) tokenize() error {
	for l.pos < len(l.src) {
		ch := l.src[l.pos]
		if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
			l.pos++
			continue
		}
		if ch >= '0' && ch <= '9' {
			start := l.pos
			for l.pos < len(l.src) && ((l.src[l.pos] >= '0' && l.src[l.pos] <= '9') || l.src[l.pos] == '.') {
				l.pos++
			}
			l.toks = append(l.toks, Token{Kind: TK_NUMBER, Lexeme: l.src[start:l.pos], Offset: start})
			continue
		}
		if unicode.IsLetter(rune(ch)) || ch == '_' {
			start := l.pos
			for l.pos < len(l.src) && (unicode.IsLetter(rune(l.src[l.pos])) || unicode.IsDigit(rune(l.src[l.pos])) || l.src[l.pos] == '_') {
				l.pos++
			}
			l.toks = append(l.toks, Token{Kind: TK_IDENT, Lexeme: l.src[start:l.pos], Offset: start})
			continue
		}
		switch ch {
		case '+':
			l.toks = append(l.toks, Token{Kind: TK_PLUS, Lexeme: "+", Offset: l.pos})
		case '-':
			l.toks = append(l.toks, Token{Kind: TK_MINUS, Lexeme: "-", Offset: l.pos})
		case '*':
			l.toks = append(l.toks, Token{Kind: TK_STAR, Lexeme: "*", Offset: l.pos})
		case '/':
			l.toks = append(l.toks, Token{Kind: TK_SLASH, Lexeme: "/", Offset: l.pos})
		case '(':
			l.toks = append(l.toks, Token{Kind: TK_LPAREN, Lexeme: "(", Offset: l.pos})
		case ')':
			l.toks = append(l.toks, Token{Kind: TK_RPAREN, Lexeme: ")", Offset: l.pos})
		case ',':
			l.toks = append(l.toks, Token{Kind: TK_COMMA, Lexeme: ",", Offset: l.pos})
		default:
			return fmt.Errorf("lex error at offset %d: unexpected character %q", l.pos, ch)
		}
		l.pos++
	}
	l.toks = append(l.toks, Token{Kind: TK_EOF, Offset: l.pos})
	return nil
}

// ---------- AST ----------

// NodeKind identifies a parsed AST node family.
type NodeKind int

const (
	ND_NUMBER NodeKind = iota
	ND_IDENT
	ND_CALL
	ND_BINOP
)

// Node is a simple tagged-union AST node. For ND_BINOP, Op is one of +, -, *, /.
type Node struct {
	Kind     NodeKind
	Number   float64
	Ident    string
	Op       TokenKind
	Children []*Node
	Offset   int
}

// ---------- Parser ----------

// Parser is a recursive-descent parser over a slice of tokens.
type Parser struct {
	toks []Token
	pos  int
}

// Parse lexes and parses src, returning the root AST node.
func Parse(src string) (*Node, error) {
	lex, err := NewLexerRenamed(src)
	if err != nil {
		return nil, err
	}
	p := &Parser{toks: lex.toks}
	root, err := p.parseExpr()
	if err != nil {
		return nil, err
	}
	if p.peek().Kind != TK_EOF {
		return nil, fmt.Errorf("parse error at offset %d: trailing input %q", p.peek().Offset, p.peek().Lexeme)
	}
	return root, nil
}

func (p *Parser) peek() Token        { return p.toks[p.pos] }
func (p *Parser) advance() Token     { t := p.toks[p.pos]; p.pos++; return t }
func (p *Parser) check(k TokenKind) bool { return p.peek().Kind == k }

// parseExpr handles the lowest precedence level: + and -.
func (p *Parser) parseExpr() (*Node, error) {
	left, err := p.parseTerm()
	if err != nil {
		return nil, err
	}
	for p.check(TK_PLUS) || p.check(TK_MINUS) {
		op := p.advance()
		right, err := p.parseTerm()
		if err != nil {
			return nil, err
		}
		left = &Node{Kind: ND_BINOP, Op: op.Kind, Children: []*Node{left, right}, Offset: op.Offset}
	}
	return left, nil
}

// parseTerm handles * and /, which bind tighter than + and -.
func (p *Parser) parseTerm() (*Node, error) {
	left, err := p.parseFactor()
	if err != nil {
		return nil, err
	}
	for p.check(TK_STAR) || p.check(TK_SLASH) {
		op := p.advance()
		right, err := p.parseFactor()
		if err != nil {
			return nil, err
		}
		left = &Node{Kind: ND_BINOP, Op: op.Kind, Children: []*Node{left, right}, Offset: op.Offset}
	}
	return left, nil
}

// parseFactor handles atoms: numbers, identifiers, calls, and parenthesized expressions.
func (p *Parser) parseFactor() (*Node, error) {
	t := p.peek()
	switch t.Kind {
	case TK_NUMBER:
		p.advance()
		v, err := strconv.ParseFloat(t.Lexeme, 64)
		if err != nil {
			return nil, fmt.Errorf("parse error at offset %d: bad number %q", t.Offset, t.Lexeme)
		}
		return &Node{Kind: ND_NUMBER, Number: v, Offset: t.Offset}, nil
	case TK_IDENT:
		p.advance()
		if p.check(TK_LPAREN) {
			p.advance() // consume '('
			var args []*Node
			if !p.check(TK_RPAREN) {
				for {
					arg, err := p.parseExpr()
					if err != nil {
						return nil, err
					}
					args = append(args, arg)
					if !p.check(TK_COMMA) {
						break
					}
					p.advance()
				}
			}
			if !p.check(TK_RPAREN) {
				return nil, fmt.Errorf("parse error at offset %d: expected ')' in call to %s", p.peek().Offset, t.Lexeme)
			}
			p.advance()
			return &Node{Kind: ND_CALL, Ident: t.Lexeme, Children: args, Offset: t.Offset}, nil
		}
		return &Node{Kind: ND_IDENT, Ident: t.Lexeme, Offset: t.Offset}, nil
	case TK_LPAREN:
		p.advance()
		inner, err := p.parseExpr()
		if err != nil {
			return nil, err
		}
		if !p.check(TK_RPAREN) {
			return nil, fmt.Errorf("parse error at offset %d: expected ')'", p.peek().Offset)
		}
		p.advance()
		return inner, nil
	}
	return nil, fmt.Errorf("parse error at offset %d: unexpected token %s", t.Offset, t.Kind)
}

// ---------- Evaluator ----------

// Env is the variable + function environment passed to Eval.
type Env struct {
	Vars  map[string]float64
	Funcs map[string]func([]float64) (float64, error)
}

// DefaultEnv returns an Env pre-populated with sin, cos, sqrt, and the
// variables pi, e. Callers are free to add their own bindings.
func DefaultEnv() Env {
	return Env{
		Vars: map[string]float64{
			"pi": math.Pi,
			"e":  math.E,
		},
		Funcs: map[string]func([]float64) (float64, error){
			"sin": func(a []float64) (float64, error) {
				if len(a) != 1 {
					return 0, fmt.Errorf("sin expects 1 arg, got %d", len(a))
				}
				return math.Sin(a[0]), nil
			},
			"cos": func(a []float64) (float64, error) {
				if len(a) != 1 {
					return 0, fmt.Errorf("cos expects 1 arg, got %d", len(a))
				}
				return math.Cos(a[0]), nil
			},
			"sqrt": func(a []float64) (float64, error) {
				if len(a) != 1 {
					return 0, fmt.Errorf("sqrt expects 1 arg, got %d", len(a))
				}
				if a[0] < 0 {
					return 0, fmt.Errorf("sqrt of negative number")
				}
				return math.Sqrt(a[0]), nil
			},
			"max": func(a []float64) (float64, error) {
				if len(a) == 0 {
					return 0, fmt.Errorf("max expects >= 1 arg")
				}
				m := a[0]
				for _, v := range a[1:] {
					if v > m {
						m = v
					}
				}
				return m, nil
			},
			"min": func(a []float64) (float64, error) {
				if len(a) == 0 {
					return 0, fmt.Errorf("min expects >= 1 arg")
				}
				m := a[0]
				for _, v := range a[1:] {
					if v < m {
						m = v
					}
				}
				return m, nil
			},
		},
	}
}

// Eval interprets the AST against env and returns a float64 result.
func Eval(n *Node, env Env) (float64, error) {
	switch n.Kind {
	case ND_NUMBER:
		return n.Number, nil
	case ND_IDENT:
		v, ok := env.Vars[n.Ident]
		if !ok {
			return 0, fmt.Errorf("undefined variable %q at offset %d", n.Ident, n.Offset)
		}
		return v, nil
	case ND_CALL:
		f, ok := env.Funcs[n.Ident]
		if !ok {
			return 0, fmt.Errorf("undefined function %q at offset %d", n.Ident, n.Offset)
		}
		args := make([]float64, 0, len(n.Children))
		for _, child := range n.Children {
			v, err := Eval(child, env)
			if err != nil {
				return 0, err
			}
			args = append(args, v)
		}
		return f(args)
	case ND_BINOP:
		l, err := Eval(n.Children[0], env)
		if err != nil {
			return 0, err
		}
		r, err := Eval(n.Children[1], env)
		if err != nil {
			return 0, err
		}
		switch n.Op {
		case TK_PLUS:
			return l + r, nil
		case TK_MINUS:
			return l - r, nil
		case TK_STAR:
			return l * r, nil
		case TK_SLASH:
			if r == 0 {
				return 0, fmt.Errorf("division by zero at offset %d", n.Offset)
			}
			return l / r, nil
		}
		return 0, fmt.Errorf("unknown binop %s at offset %d", n.Op, n.Offset)
	}
	return 0, fmt.Errorf("unknown node kind %d", n.Kind)
}

// String returns a human-readable dump of the AST for debugging. Not used
// by tests but kept as an illustration of how to walk the tree.
func (n *Node) String() string {
	switch n.Kind {
	case ND_NUMBER:
		return strconv.FormatFloat(n.Number, 'g', -1, 64)
	case ND_IDENT:
		return n.Ident
	case ND_CALL:
		args := make([]string, 0, len(n.Children))
		for _, c := range n.Children {
			args = append(args, c.String())
		}
		return n.Ident + "(" + strings.Join(args, ", ") + ")"
	case ND_BINOP:
		return "(" + n.Children[0].String() + " " + n.Op.String() + " " + n.Children[1].String() + ")"
	}
	return "?"
}
