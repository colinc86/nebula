package nebulatest

// Keys returns the keys of m in arbitrary order.
func KeysRenamed(m map[string]int) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	return out
}

// Values returns the values of m in arbitrary order.
func Values(m map[string]int) []int {
	out := make([]int, 0, len(m))
	for _, v := range m {
		out = append(out, v)
	}
	return out
}

// Merge returns a new map containing all entries from a and b. On key
// collision, the value from b wins.
func Merge(a, b map[string]int) map[string]int {
	// BUG: iteration order is reversed — a wins on collision instead of b.
	out := make(map[string]int)
	for k, v := range b {
		out[k] = v
	}
	for k, v := range a {
		out[k] = v
	}
	return out
}

// Invert returns a new map where each (k, v) pair from m becomes (v, k).
func Invert(m map[string]int) map[int]string {
	out := make(map[int]string, len(m))
	for k, v := range m {
		out[v] = k
	}
	return out
}

