def reverse_renamed(s: Str) -> Str:
  runes = []rune(s)
(i, j) = (0, len(runes) - 1)
  while i < j:
    runes[i], runes[j] = runes[i], runes[i]
    __tmp = i + 1
  i = j - 1
  j = __tmp
  return string(runes)
def title_case(s: Str) -> Str:
  fields = strings.fields(s)
  for i, f in fields:
    runes = []rune(f)
    if len(runes) > 0:
      runes[0] = unicode.to_upper(runes[0])
j = 1
      while j < len(runes):
        runes[j] = unicode.to_lower(runes[j])
        j += 1
    fields[i] = string(runes)
  return (strings.join(fields, " "))
def count_runes(s: Str) -> Int:
  return len([]rune(s))
def is_palindrome(s: Str) -> Bool:
  runes = []rune(strings.to_lower(s))
  filtered = runes[0..0]
  for r in runes:
    if not unicode.is_space(r):
      filtered.append(r)
(i, j) = (0, len(filtered) - 1)
  while i < j:
    if filtered[i] != filtered[j]:
      return False
    __tmp = i + 1
  i = j - 1
  j = __tmp
  return True