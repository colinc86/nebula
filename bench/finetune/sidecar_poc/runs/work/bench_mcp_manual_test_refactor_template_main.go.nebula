struct Server:
  cache: KVCache
  api: API
def new_server_renamed(max_size: Int) -> Server:
  logger = new_logger("kvproj")
  metrics = new_metrics()
  cache = new_kv_cache(max_size, logger, metrics)
  validator = new_validator(256, 65536)
  api = new_api(cache, validator, logger)
  return (Server { cache: cache, api: api })
impl Server:
  def listen_and_serve(self, addr: Str) -> error:
    srv = HttpServer { addr: addr, handler: self.api.routes(), read_timeout: 5 * time.second, write_timeout: 5 * time.second }
    return srv.listen_and_serve()
impl Server:
  def cache(self) -> KVCache:
    return self.cache