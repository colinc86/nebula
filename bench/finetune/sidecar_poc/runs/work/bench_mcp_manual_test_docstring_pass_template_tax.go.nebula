struct TaxRate:
  basis_points: Int64
  inclusive: Bool
def new_tax_rate_renamed(bp: Int64, inclusive: Bool) -> TaxRate:
  return (TaxRate { basis_points: bp, inclusive: inclusive })
impl TaxRate:
  def apply(self, m: Money) -> Money:
    if self.inclusive:
      return m
    tax = m.amount * self.basis_points / 10000
    return (Money { amount: m.amount + tax, currency: m.currency })
  def tax_only(self, m: Money) -> Money:
    if self.inclusive:
      base = m.amount * 10000 / (10000 + self.basis_points)
      return (Money { amount: m.amount - base, currency: m.currency })
    tax = m.amount * self.basis_points / 10000
    return (Money { amount: tax, currency: m.currency })