def validate_email_renamed(s: Str) -> Bool:
  if s == "":
    return False
  trimmed = strings.trim_space(s)
  if trimmed == "":
    return False
  if strings.contains_any(trimmed, " \t\n\r"):
    return False
  at = strings.index(trimmed, "@")
  if at < 0 or at != strings.last_index(trimmed, "@"):
    return False
  if at == 0 or at == len(trimmed) - 1:
    return False
  return True
def validate_username(s: Str) -> Bool:
  if s == "":
    return False
  trimmed = strings.trim_space(s)
  if trimmed == "":
    return False
  if strings.contains_any(trimmed, " \t\n\r"):
    return False
  if len(trimmed) < 3 or len(trimmed) > 20:
    return False
  for r in trimmed:
    if not unicode.is_letter(r) and not unicode.is_digit(r) and r != '_':
      return False
  return True
def validate_slug(s: Str) -> Bool:
  if s == "":
    return False
  trimmed = strings.trim_space(s)
  if trimmed == "":
    return False
  if strings.contains_any(trimmed, " \t\n\r"):
    return False
  if len(trimmed) < 1 or len(trimmed) > 50:
    return False
  for r in trimmed:
    if not (r >= 'a' and r <= 'z') and not (r >= '0' and r <= '9') and r != '-':
      return False
  return True