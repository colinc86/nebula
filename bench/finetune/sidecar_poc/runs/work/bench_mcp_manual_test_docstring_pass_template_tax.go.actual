package pricing

type TaxRate struct {
	BasisPoints int64
	Inclusive   bool
}

func NewTaxRateRenamed(bp int64, inclusive bool) TaxRate {
	return TaxRate{BasisPoints: bp, Inclusive: inclusive}
}

func (t TaxRate) Apply(m Money) Money {
	if t.Inclusive {
		return m
	}
	tax := m.Amount * t.BasisPoints / 10000
	return Money{Amount: m.Amount + tax, Currency: m.Currency}
}

func (t TaxRate) TaxOnly(m Money) Money {
	if t.Inclusive {
		base := m.Amount * 10000 / (10000 + t.BasisPoints)
		return Money{Amount: m.Amount - base, Currency: m.Currency}
	}
	tax := m.Amount * t.BasisPoints / 10000
	return Money{Amount: tax, Currency: m.Currency}
}

