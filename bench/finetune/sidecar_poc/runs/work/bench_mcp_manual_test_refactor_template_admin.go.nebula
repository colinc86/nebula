struct AdminTool:
  cache: KVCache
  logger: Logger
def new_admin_tool_renamed(cache: KVCache, logger: Logger) -> AdminTool:
  return (AdminTool { cache: cache, logger: logger })
impl AdminTool:
  def execute(self, line: Str) -> (string, error):
    fields = strings.fields(line)
    if len(fields) == 0:
      return ("", fmt.errorf("empty command"))
    match fields[0]:
      "get" => if len(fields) != 2 {
          return ("", fmt.errorf("usage: get <key>"))
        (v, ok) = self.cache.get(fields[1])
        if not ok:
          return ("<missing>", None)
        return (v, None)
      "set" => if len(fields) != 3 {
          return ("", fmt.errorf("usage: set <key> <value>"))
        self.cache.Set(fields[1], fields[2])
        return ("ok", None)
      "delete" => if len(fields) != 2 {
          return ("", fmt.errorf("usage: delete <key>"))
        if not self.cache.delete(fields[1]):
          return ("<missing>", None)
        return ("ok", None)
      "size" => ("{self.cache.len()), None}"
      _ => ("", fmt.errorf("unknown command: %s", fields[0]))