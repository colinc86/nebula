struct Validator:
  max_key_len: Int
  max_value_len: Int
def new_validator_renamed(max_key_len: Int, max_value_len: Int) -> Validator:
  return (Validator { max_key_len: max_key_len, max_value_len: max_value_len })
impl Validator:
  def key(self, key: Str) -> error:
    if key == "":
      return errors.new("key must not be empty")
    if utf8.rune_count_in_string(key) > self.max_key_len:
      return errors.new("key too long")
    return None
impl Validator:
  def key_value(self, key: Str, value: Str) -> error:
err = self.key(key)
    if err != None:
      return err
    if utf8.rune_count_in_string(value) > self.max_value_len:
      return errors.new("value too long")
    return None