struct Snapshot:
  entries: Map
def snapshot_kv_cache_renamed(c: KVCache) -> Snapshot:
  c.mu.r_lock()
  defer c.mu.r_unlock()
  snap = Snapshot { entries: make("map[string]string, len(c.data)") }
  for k, e in c.data:
    if not e.expires_at.is_zero():
      continue
    snap.entries[k] = e.value
  return snap
def restore_kv_cache(c: KVCache, snap: Snapshot):
  for k, v in snap.entries:
    c.Set(k, v)
def write_snapshot(w: IoWriter, snap: Snapshot) -> error:
  enc = json.new_encoder(w)
  enc.set_indent("", "  ")
err = enc.encode(snap)
  if err != None:
    return (fmt.errorf("write snapshot: %w", err))
  return None
def read_snapshot(r: IoReader) -> (Snapshot, error):
  snap = nil
err = json.new_decoder(r).decode(snap)
  if err != None:
    return (None, fmt.errorf("read snapshot: %w", err))
  return (snap, None)