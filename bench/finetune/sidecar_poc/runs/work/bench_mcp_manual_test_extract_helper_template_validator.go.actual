package nebulatest

import (
	"strings"
	"unicode"
)

// ValidateEmail reports whether s looks like a valid email (very loose check).
// Rules: non-empty, contains exactly one '@', local and domain parts are
// non-empty, no spaces.
func ValidateEmailRenamed(s string) bool {
	if s == "" {
		return false
	}
	trimmed := strings.TrimSpace(s)
	if trimmed == "" {
		return false
	}
	if strings.ContainsAny(trimmed, " \t\n\r") {
		return false
	}
	at := strings.Index(trimmed, "@")
	if at < 0 || at != strings.LastIndex(trimmed, "@") {
		return false
	}
	if at == 0 || at == len(trimmed)-1 {
		return false
	}
	return true
}

// ValidateUsername reports whether s is a valid username: non-empty after
// trimming, alphanumeric + underscore only, 3-20 characters.
func ValidateUsername(s string) bool {
	if s == "" {
		return false
	}
	trimmed := strings.TrimSpace(s)
	if trimmed == "" {
		return false
	}
	if strings.ContainsAny(trimmed, " \t\n\r") {
		return false
	}
	if len(trimmed) < 3 || len(trimmed) > 20 {
		return false
	}
	for _, r := range trimmed {
		if !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '_' {
			return false
		}
	}
	return true
}

// ValidateSlug reports whether s is a URL slug: non-empty after trimming,
// lowercase alphanumeric + hyphen only, 1-50 characters.
func ValidateSlug(s string) bool {
	if s == "" {
		return false
	}
	trimmed := strings.TrimSpace(s)
	if trimmed == "" {
		return false
	}
	if strings.ContainsAny(trimmed, " \t\n\r") {
		return false
	}
	if len(trimmed) < 1 || len(trimmed) > 50 {
		return false
	}
	for _, r := range trimmed {
		if !(r >= 'a' && r <= 'z') && !(r >= '0' && r <= '9') && r != '-' {
			return false
		}
	}
	return true
}

